# Host the MCP server (Streamable HTTP) binds to. Defaults to 127.0.0.1 so the
# unauthenticated endpoint is not exposed on every interface. Set to 0.0.0.0
# inside a container that needs to accept connections from the host.
MCP_SERVER_HOST=127.0.0.1

# Port the MCP server (Streamable HTTP) listens on
MCP_SERVER_PORT=3001

# URL the mcp-server fetches the MCP App single-file HTML bundle from.
# The mcp-app serves it via `vite preview`; the server relays it inline.
#   Docker Compose value (service DNS): http://mcp-app:4173/
#   Host direct-run value:              http://localhost:4173/
MCP_APP_BUNDLE_URL=http://mcp-app:4173/
